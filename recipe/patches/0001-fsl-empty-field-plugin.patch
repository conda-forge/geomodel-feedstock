From 8c17c9976440b6210093841afc0827429a5056f4 Mon Sep 17 00:00:00 2001
From: Oliver Lantwin <oliver.lantwin@cern.ch>
Date: Tue, 13 Oct 2026 20:30:59 +0200
Subject: [PATCH] FullSimLight - Run without a field when neither a value nor a
 plugin is set

FSLDetectorConstruction starts with fFieldConstant=false and an empty
mag_field_plugin_path. Only /FSLdet/setField or a JSON config with a
"Plugin" field type changes either. A user macro passed with -m that
does neither therefore reaches the plugin branch of
ConstructSDandField with an empty path. basename("") is ".", and
GeoPluginLoader::load then throws std::out_of_range from substr(3),
aborting /run/initialize.

Treat an empty plugin path as "field off". Raise a fatal G4Exception
if a plugin path is given but cannot be loaded, instead of
dereferencing nullptr. GeoPluginLoader::load now rejects paths whose
file name does not start with "lib" and returns nullptr, like its
other failure paths.

Reported in https://github.com/ShipSoft/Geometry/issues/90

Assisted-by: Claude Code:claude-opus-5-5
---
 FullSimLight/src/FSLDetectorConstruction.cc           | 11 +++++++++++
 .../GeoModelKernel/GeoModelKernel/GeoPluginLoader.h   |  5 +++++
 2 files changed, 16 insertions(+)

diff --git a/FullSimLight/src/FSLDetectorConstruction.cc b/FullSimLight/src/FSLDetectorConstruction.cc
index bcf66d9c..48660634 100644
--- a/FullSimLight/src/FSLDetectorConstruction.cc
+++ b/FullSimLight/src/FSLDetectorConstruction.cc
@@ -372,6 +372,12 @@ void FSLDetectorConstruction::ConstructSDandField()
     else if (fFieldConstant && fFieldValue == 0.0 ){
         G4cout << G4endl << " *** MAGNETIC FIELD IS OFF  *** " << G4endl << G4endl;
     }
+    else if (mag_field_plugin_path.empty())
+    {
+        // Neither /FSLdet/setField nor a field plugin was given (e.g. a user macro
+        // passed with -m that does not set the field): run without a field.
+        G4cout << G4endl << " *** MAGNETIC FIELD IS OFF (no field value or plugin given) *** " << G4endl << G4endl;
+    }
     else // if (!fFieldConstant)
         {
           G4cout << G4endl << " *** MAGNETIC FIELD SET FROM PLUGIN  *** " << G4endl << G4endl;
@@ -380,6 +386,11 @@ void FSLDetectorConstruction::ConstructSDandField()
               {
               GeoPluginLoader<MagFieldPlugin> loader;
               MagFieldPlugin *plugin=loader.load(mag_field_plugin_path);
+              if (plugin==nullptr) {
+                G4Exception("FSLDetectorConstruction::ConstructSDandField()", "FSL0001", FatalException,
+                            ("Could not load magnetic field plugin " + mag_field_plugin_path).c_str());
+                return;
+              }
               G4MagneticField *g4Field=plugin->getField();
               delete plugin;
               if(g4Field==nullptr) std::cout<<"Error, g4Field is null!"<<std::endl;
diff --git a/GeoModelCore/GeoModelKernel/GeoModelKernel/GeoPluginLoader.h b/GeoModelCore/GeoModelKernel/GeoModelKernel/GeoPluginLoader.h
index e0d45692..cc79189c 100644
--- a/GeoModelCore/GeoModelKernel/GeoModelKernel/GeoPluginLoader.h
+++ b/GeoModelCore/GeoModelKernel/GeoModelKernel/GeoPluginLoader.h
@@ -45,6 +45,11 @@ GeoPluginLoader<Plugin>::~GeoPluginLoader () {
 template <class Plugin>
 Plugin *GeoPluginLoader<Plugin>::load(const std::string & pString) const {
   std::string bNameString=basename ((char *) pString.c_str());       // Strip off the directory
+  if (bNameString.rfind("lib",0)!=0) {
+    std::cerr << "GeoPluginLoader: cannot load plugin from \"" << pString
+              << "\", expected a path to a lib<Name>.so file" << std::endl;
+    return nullptr;
+  }
   bNameString=bNameString.substr(3);                        // Strip off leading "lib"
   bNameString=bNameString.substr(0,bNameString.find("."));  // Strip off extensions
   
